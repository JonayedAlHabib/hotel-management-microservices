PORT=4001
# no database name at the end — connectDB (src/db/db.js) appends DB_NAME (src/constant.js) itself
# local standalone: mongodb://localhost:27017
# via docker-compose:  mongodb://mongo:27017
MONGO_URI=mongodb://localhost:27017
JWT_SECRET=change-me-in-real-env
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
# local standalone: redis://localhost:6379
# via docker-compose:  redis://redis:6379
REDIS_URL=redis://localhost:6379
